NEXT_PUBLIC_SITE_URL=https://www.abubakkaracademy.com
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=989476746933754,2200034287537050
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview). Not loaded on /admin.
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_WHATSAPP_NUMBER=923335767202
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/share/183vzkYTJP/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/abubakkaracademy/
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
# First admin login (creates the first admin account on first sign-in; add more admins in /admin → Settings)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me-long-random-10+chars
ADMIN_COOKIE_SECRET=another-long-random-string
# Optional automated emails (receipt-uploaded alert to admin and enrollment confirmation to parents). Easiest: a Gmail account with an App Password.
# Google Account -> Security -> 2-Step Verification -> App passwords -> create one (16 letters, no spaces).
# Brevo (used first when set; works on Vercel because it goes over HTTPS). The sender must be verified in Brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Abu Bakkar Academy
BREVO_REPLY_TO=
# Your own mailbox over SMTP (for example GoDaddy: smtpout.secureserver.net port 465). Put the password in double quotes if it contains #.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Gmail alternative:
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Alternative to Gmail: Resend (only used when GMAIL_USER is empty)
RESEND_API_KEY=
RESEND_FROM=Abu Bakkar Academy <noreply@abubakkaracademy.com>
# With these two set, the admin also gets an email whenever a parent uploads a payment receipt (set who in Admin → Settings).
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_ID=

# Optional: server-side Meta Conversions API (Purchase after verified payment). Uses NEXT_PUBLIC_META_PIXEL_ID.
META_CAPI_TOKEN=

# AI assistant (chat button). Leave OPENAI_API_KEY empty and the chat button is hidden.
# Create the key at platform.openai.com and set a monthly spend limit there. CHAT_MODEL defaults to gpt-4.1-mini (cheap).
OPENAI_API_KEY=
CHAT_MODEL=
CHAT_RATE_LIMIT=
CHAT_DAILY_LIMIT=
# Used only until payment numbers are entered in Admin → Settings
CHAT_PAYMENT_NUMBER=03335760892
